# ─── SERVER ──────────────────────────────────────────────
NODE_ENV=production
APP_ENV=staging
PORT=4001
API_PREFIX=/api

# ─── DATABASE ────────────────────────────────────────────
DATABASE_URL="postgresql://modern_staging_user:<PASSWORD>@<RDS_ENDPOINT>:5432/modern_staging?sslmode=require"
EXPECTED_DATABASE_NAME=modern_staging

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=<STAGING_JWT_SECRET_MINIMUM_32_CHARS>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<STAGING_JWT_REFRESH_SECRET_MINIMUM_32_CHARS>
JWT_REFRESH_EXPIRES_IN=30d

# ─── FRONTEND ────────────────────────────────────────────
FRONTEND_URL=https://<STAGING_FRONTEND_DOMAIN>
EXPECTED_FRONTEND_HOST=<STAGING_FRONTEND_DOMAIN>
CUSTOMER_PASSWORD_RESET_URL=https://<STAGING_FRONTEND_DOMAIN>/reset-password

# ─── STORAGE ─────────────────────────────────────────────
STORAGE_PROVIDER=s3
AWS_REGION=eu-central-1
AWS_S3_BUCKET=<STAGING_S3_BUCKET>
EXPECTED_S3_BUCKET=<STAGING_S3_BUCKET>
LOCAL_UPLOAD_PATH=uploads

# Cloudinary (only needed when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=modortho-staging

# ─── PAYMENTS ────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://<STAGING_FRONTEND_DOMAIN>/checkout/success
STRIPE_CANCEL_URL=https://<STAGING_FRONTEND_DOMAIN>/checkout/cancel

# ─── SHIPPING ────────────────────────────────────────────
DHL_API_KEY=
DHL_BASE_URL=https://api-eu.dhl.com
DTDC_API_KEY=
DTDC_BASE_URL=

# ─── EMAIL (Resend) ──────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=orders@<STAGING_DOMAIN>
EMAIL_NOTIFY=team@<STAGING_DOMAIN>

# ─── AI / LANGCHAIN ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# ─── TAX / ADDRESS VALIDATION ────────────────────────────
GOOGLE_MAPS_API_KEY=
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
GST_VALIDATION_URL=
GST_VALIDATION_API_KEY=
GST_VALIDATION_TIMEOUT_MS=7000
TAX_VALIDATION_CACHE_TTL_MS=86400000
VIES_TIMEOUT_MS=7000

# ─── STORE METADATA ──────────────────────────────────────
STORE_NAME=Modern Orthodontics
STORE_ADDRESS=
STORE_EMAIL=orders@<STAGING_DOMAIN>
STORE_URL=https://<STAGING_FRONTEND_DOMAIN>

# ─── CURRENCY SYNC ───────────────────────────────────────
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# ─── SECURITY / SETTINGS ─────────────────────────────────
SETTINGS_ENCRYPTION_KEY=<STAGING_32_BYTE_SETTINGS_ENCRYPTION_KEY>

# ─── LOGGING ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  password     String
  roleId       String
  status       UserStatus      @default(ACTIVE)
  lastLoginAt  DateTime?
  refreshToken String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  ActivityLog  ActivityLog[]
  blogAuthors  BlogAuthor[]
  QuoteNote    QuoteNote[]
  role         Role            @relation(fields: [roleId], references: [id])
  warehouses   UserWarehouse[]
  notifications Notification[]
  deviceTokens  DeviceToken[]

  @@map("users")
}

model Warehouse {
  id             String   @id @default(cuid())
  name           String
  countryId      String
  state          String
  address        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  postalCode     String?
  gstin          String?
  deliveryStates String[] @default([])
  status         Status   @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  country       Country         @relation("WarehousePhysicalCountry", fields: [countryId], references: [id])
  deliveryZones Json            @default("[]")
  inventories   Inventory[]
  orders        Order[]
  users         UserWarehouse[]
  orderItems    OrderItem[]
  shipments     Shipment[]

  @@map("warehouses")
}

model UserWarehouse {
  userId      String
  warehouseId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model Category {
  id             String                @id @default(uuid())
  name           String
  slug           String                @unique
  description    String?
  parentId       String?
  image          String?
  status         Status                @default(ACTIVE)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  parent         Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]            @relation("CategoryHierarchy")
  translations   CategoryTranslation[]
  seoTitle       String?
  seoDescription String?
  products       Product[]
  countries      CategoryCountry[]
  discounts      DiscountCategory[]
  taxRules       TaxRule[]             @relation("CategoryTaxRules")

  @@map("categories")
}

model Collection {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  status      Status               @default(ACTIVE)
  sortOrder   Int                  @default(0)
  description String?
  image       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  products    CollectionProduct[]
  countries   CollectionCountry[]
  discounts   DiscountCollection[]

  @@map("collections")
}

model Product {
  id                     String                 @id @default(cuid())
  title                  String
  slug                   String                 @unique
  shortDescription       String?
  description            String?
  informationImage       String?
  informationDescription String?
  sortOrder              Int                    @default(0)
  categoryId             String
  sku                    String?                @unique
  productCode            String?
  hsnCode                String?
  brand                  String                 @default("Modern Orthodontics")
  status                 ProductStatus          @default(DRAFT)
  isFeatured             Boolean                @default(false)
  hasVariants            Boolean                @default(false)
  defaultCountryId       String?
  defaultCurrencyId      String?
  seoTitle               String?
  seoDescription         String?
  seoKeywords            String?
  highlights             Json?
  technicalSpecs         Json?
  warranty               Json?
  primaryFeatures        Json?
  additionalInfo         Json?
  packageWeight          Decimal?               @db.Decimal(10, 3)
  packageLength          Decimal?               @db.Decimal(10, 2)
  packageWidth           Decimal?               @db.Decimal(10, 2)
  packageHeight          Decimal?               @db.Decimal(10, 2)
  shippingClass          String?
  fragile                Boolean                @default(false)
  hazardous              Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  OrderItem              OrderItem[]
  attributes             ProductAttribute[]
  inventories            Inventory[]
  media                  ProductMedia[]
  packages               ProductPackage[]
  prices                 ProductPrice[]
  translations           ProductTranslation[]
  variants               ProductVariant[]
  collections            CollectionProduct[]
  countries              ProductCountry[]
  discounts              DiscountProduct[]
  moqPricing             MoqPricing[]
  tierPricing            TierPricing[]
  category               Category               @relation(fields: [categoryId], references: [id])
  defaultCountry         Country?               @relation(fields: [defaultCountryId], references: [id])
  defaultCurrency        Currency?              @relation(fields: [defaultCurrencyId], references: [id])
  QuoteItem              QuoteItem[]
  taxRules               TaxRule[]              @relation("ProductTaxRules")
  reviews                ProductReview[]
  wishlistItems          Wishlist[]
  paymentMethods         ProductPaymentMethod[]

  @@map("products")
}

model ProductPackage {
  id          String           @id @default(cuid())
  productId   String
  title       String
  slug        String
  image       String?
  description String?
  status      Status           @default(ACTIVE)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  product     Product          @relation(fields: [productId], references: [id])
  variants    ProductVariant[]

  @@unique([productId, slug])
  @@map("product_packages")
}

model ProductMedia {
  id              String          @id @default(cuid())
  productId       String
  url             String
  publicId        String?
  type            MediaType       @default(IMAGE)
  altText         String?
  sortOrder       Int             @default(0)
  storageProvider StorageProvider @default(LOCAL)
  createdAt       DateTime        @default(now())
  product         Product         @relation(fields: [productId], references: [id])

  @@map("product_media")
}

model Attribute {
  id                String                         @id @default(uuid())
  name              String
  slug              String                         @unique
  role              AttributeRole                  @default(DROPDOWN)
  status            AttributeStatus                @default(ACTIVE)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  sortOrder         Int                            @default(0)
  values            AttributeValue[]
  productAttributes ProductAttribute[]
  variantValues     ProductVariantAttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id                String                           @id @default(uuid())
  attributeId       String
  value             String
  slug              String
  sortOrder         Int                              @default(0)
  gridRole          GridRole?
  countryId         String?
  moq               Int?
  tierPrice         Decimal?                         @db.Decimal(10, 2)
  dealerPrice       Decimal?                         @db.Decimal(10, 2)
  status            AttributeStatus                  @default(ACTIVE)
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  image             String?
  note              String?
  priceAdjustment   Decimal                          @default(0) @db.Decimal(12, 2)
  attribute         Attribute                        @relation(fields: [attributeId], references: [id])
  country           Country?                         @relation("CountryAttributeValues", fields: [countryId], references: [id])
  productSelections ProductAttributeValueSelection[]
  variantValues     ProductVariantAttributeValue[]

  @@unique([attributeId, slug])
  @@map("attribute_values")
}

model ProductAttribute {
  id            String                           @id @default(cuid())
  productId     String
  attributeId   String
  required      Boolean                          @default(false)
  gridAxis      GridAxis?
  createdAt     DateTime                         @default(now())
  allowedValues ProductAttributeValueSelection[]
  attribute     Attribute                        @relation(fields: [attributeId], references: [id])
  product       Product                          @relation(fields: [productId], references: [id])

  @@unique([productId, attributeId])
  @@map("product_attributes")
}

model ProductAttributeValueSelection {
  id                 String           @id @default(cuid())
  productAttributeId String
  attributeValueId   String
  createdAt          DateTime         @default(now())
  attributeValue     AttributeValue   @relation(fields: [attributeValueId], references: [id])
  productAttribute   ProductAttribute @relation(fields: [productAttributeId], references: [id])

  @@unique([productAttributeId, attributeValueId])
  @@map("product_attribute_value_selections")
}

model ProductVariant {
  id                   String                         @id @default(cuid())
  productId            String
  sku                  String?                        @unique
  title                String
  variantKey           String
  status               Status                         @default(ACTIVE)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  height               Decimal?                       @db.Decimal(10, 2)
  length               Decimal?                       @db.Decimal(10, 2)
  moq                  Int                            @default(1)
  packageId            String?
  weight               Decimal?                       @db.Decimal(10, 3)
  width                Decimal?                       @db.Decimal(10, 2)
  shippingClass        String?
  fragile              Boolean                        @default(false)
  hazardous            Boolean                        @default(false)
  inventories          Inventory[]
  inventoryAdjustments InventoryAdjustment[]
  moqPricing           MoqPricing[]
  tierPricing          TierPricing[]
  OrderItem            OrderItem[]
  countries            VariantCountry[]
  prices               ProductPrice[]
  attributeValues      ProductVariantAttributeValue[]
  package              ProductPackage?                @relation(fields: [packageId], references: [id])
  product              Product                        @relation(fields: [productId], references: [id])
  QuoteItem            QuoteItem[]
  taxRules             TaxRule[]                      @relation("VariantTaxRules")
  paymentMethods       VariantPaymentMethod[]

  @@map("product_variants")
}

model ProductVariantAttributeValue {
  id               String         @id @default(cuid())
  variantId        String
  attributeId      String
  attributeValueId String
  attribute        Attribute      @relation(fields: [attributeId], references: [id])
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, attributeId])
  @@map("product_variant_attribute_values")
}

model Country {
  id                    String                 @id @default(uuid())
  name                  String
  code                  String                 @unique
  currencyId            String
  status                CountryStatus          @default(ACTIVE)
  isDefault             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now())
  sortOrder             Int                    @default(0)
  dutyPercentage        Decimal                @default(0) @db.Decimal(5, 2)
  currency              Currency               @relation(fields: [currencyId], references: [id])
  banners               Banner[]
  categoryCountries     CategoryCountry[]
  collectionCountries   CollectionCountry[]
  inventories           Inventory[]
  defaultCustomers      Customer[]             @relation("CustomerDefaultCountry")
  customerAddresses     CustomerAddress[]      @relation("CustomerAddressCountry")
  productCountries      ProductCountry[]
  discounts             DiscountCountry[]
  moqPricing            MoqPricing[]
  tierCountries         TierCountry[]
  attributeValues       AttributeValue[]       @relation("CountryAttributeValues")
  couponCountries       CouponCountry[]
  bannerCountries       BannerCountry[]
  taxRuleCountries      TaxRuleCountry[]
  Coupon                Coupon[]
  Order                 Order[]
  prices                ProductPrice[]
  shippingZoneCountries ShippingZoneCountry[]
  shippingBoxCountries  ShippingBoxCountry[]
  taxRules              TaxRule[]
  defaultProducts       Product[]
  tierPricing           TierPricing[]
  Quote                 Quote[]
  variantCountries      VariantCountry[]
  paymentMethods        PaymentMethodCountry[]
  warehouses            Warehouse[]            @relation("WarehousePhysicalCountry")

  @@map("countries")
}

model Tier {
  id        String        @id @default(uuid())
  name      String        @unique
  status    Status        @default(ACTIVE)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  customers Customer[]
  discounts Discount[]
  countries TierCountry[]
  pricing   TierPricing[]

  @@map("tiers")
}

model CustomerRole {
  id          String     @id @default(uuid())
  key         String     @unique
  name        String     @unique
  description String?
  status      Status     @default(ACTIVE)
  isSystem    Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]

  @@map("customer_roles")
}

model TierCountry {
  id        String   @id @default(uuid())
  tierId    String
  countryId String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tier      Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  country   Country  @relation(fields: [countryId], references: [id])

  @@unique([tierId, countryId])
  @@map("tier_countries")
}

model Customer {
  id                         String            @id @default(uuid())
  email                      String            @unique
  passwordHash               String
  firstName                  String
  lastName                   String
  phone                      String?
  companyName                String?
  website                    String?
  preferredPrescription      String?
  preferredPrescriptionOther String?
  preferredSlot              String?
  currentPractice            String?
  currentPracticeOther       String?
  usingModernProducts        Boolean           @default(false)
  status                     Status            @default(ACTIVE)
  customerType               CustomerType      @default(RETAIL)
  approvalStatus             ApprovalStatus    @default(ACTIVE)
  emailVerifiedAt            DateTime?
  customerRoleId             String?
  tierId                     String?
  defaultCountryId           String?
  refreshToken               String?
  taxId                      String?
  taxIdType                  String? // "GSTIN", "VAT", "EIN", "OTHER"
  taxIdStatus                String            @default("UNVERIFIED") // "UNVERIFIED" | "PENDING" | "VALID" | "INVALID"
  taxIdVerifiedAt            DateTime?
  vatNumber                  String?
  vatValidationStatus        String? // "VALID" | "INVALID" | "UNVERIFIED"
  vatValidatedAt             DateTime?
  vatCompanyName             String?
  vatCompanyAddress          String?
  vatCountryCode             String?
  vatValidationSource        String? // "VIES"
  taxExemptCertificateUrl    String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  deletedAt                  DateTime?
  customerRole               CustomerRole?     @relation(fields: [customerRoleId], references: [id])
  tier                       Tier?             @relation(fields: [tierId], references: [id])
  defaultCountry             Country?          @relation("CustomerDefaultCountry", fields: [defaultCountryId], references: [id])
  addresses                  CustomerAddress[]
  orders                     Order[]
  quotes                     Quote[]
  wishlistItems              Wishlist[]
  notifications              Notification[]
  deviceTokens               DeviceToken[]

  @@map("customers")
}

model CustomerAddress {
  id                 String                  @id @default(uuid())
  customerId         String
  label              String?
  fullName           String
  phone              String
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  postalCode         String
  countryId          String
  isDefault          Boolean                 @default(false)
  originalAddress    Json?
  normalizedAddress  Json?
  validationProvider String?
  validationResult   Json?
  validationStatus   AddressValidationStatus @default(UNVALIDATED)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  customer           Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  country            Country                 @relation("CustomerAddressCountry", fields: [countryId], references: [id])

  @@map("customer_addresses")
}

model Currency {
  id                      String         @id @default(cuid())
  name                    String
  code                    String         @unique
  symbol                  String
  exchangeRate            Decimal        @db.Decimal(12, 6)
  isBase                  Boolean        @default(false)
  status                  Status         @default(ACTIVE)
  updatedAt               DateTime       @updatedAt
  createdAt               DateTime       @default(now())
  countries               Country[]
  Coupon                  Coupon[]
  Order                   Order[]
  prices                  ProductPrice[]
  defaultCurrencyProducts Product[]
  Quote                   Quote[]

  @@map("currencies")
}

model ProductPrice {
  id               String          @id @default(cuid())
  productId        String
  variantId        String?
  countryId        String
  currencyId       String
  mrp              Decimal         @db.Decimal(12, 2)
  sellingPrice     Decimal         @db.Decimal(12, 2)
  dealerPrice      Decimal?        @db.Decimal(12, 2)
  distributorPrice Decimal?        @db.Decimal(12, 2)
  taxPercentage    Decimal         @default(0) @db.Decimal(5, 2)
  status           Status          @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  country          Country         @relation(fields: [countryId], references: [id])
  currency         Currency        @relation(fields: [currencyId], references: [id])
  product          Product         @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([productId, variantId, countryId])
  @@map("product_prices")
}

model Inventory {
  id                String                @id @default(cuid())
  productId         String
  variantId         String?
  countryId         String?
  stock             Int                   @default(0)
  reservedStock     Int                   @default(0)
  lowStockThreshold Int                   @default(10)
  status            InventoryStatus       @default(IN_STOCK)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  variant           ProductVariant?       @relation(fields: [variantId], references: [id])
  product           Product               @relation(fields: [productId], references: [id])
  country           Country?              @relation(fields: [countryId], references: [id])
  adjustments       InventoryAdjustment[]
  warehouseId       String?
  warehouse         Warehouse?            @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
  @@map("inventory")
}

model Coupon {
  id            String          @id @default(cuid())
  code          String          @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal         @db.Decimal(10, 2)
  minOrderValue Decimal?        @db.Decimal(10, 2)
  maxDiscount   Decimal?        @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usedCount     Int             @default(0)
  countryId     String?
  currencyId    String?
  status        Status          @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  country       Country?        @relation(fields: [countryId], references: [id])
  currency      Currency?       @relation(fields: [currencyId], references: [id])
  countries     CouponCountry[]
  orders        Order[]

  @@map("coupons")
}

model CouponCountry {
  id        String   @id @default(cuid())
  couponId  String
  countryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  country   Country  @relation(fields: [countryId], references: [id])

  @@unique([couponId, countryId])
  @@map("coupon_countries")
}

model Quote {
  id          String @id @default(cuid())
  quoteNumber String @unique

  customerName  String
  customerEmail String
  customerPhone String?
  companyName   String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  countryId  String
  currencyId String

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  status QuoteStatus @default(PENDING)
  source String      @default("CUSTOMER")

  notes     String?
  expiresAt DateTime?

  convertedOrderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingCharge Decimal @default(0) @db.Decimal(12, 2)

  shippingAddress Json?
  billingAddress  Json?

  items         QuoteItem[]
  internalNotes QuoteNote[]

  order    Order?   @relation(fields: [convertedOrderId], references: [id])
  country  Country  @relation(fields: [countryId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@index([customerId])
  @@map("quotes")
}

model QuoteItem {
  id        String          @id @default(cuid())
  quoteId   String
  productId String
  variantId String?
  title     String
  sku       String?
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  total     Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id])
  quote     Quote           @relation(fields: [quoteId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("quote_items")
}

model QuoteNote {
  id        String   @id @default(cuid())
  quoteId   String
  userId    String
  note      String
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("quote_notes")
}

model Order {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  customerName      String
  customerEmail     String
  customerPhone     String?
  companyName       String?
  shippingAddress   Json
  countryId         String
  currencyId        String
  subtotal          Decimal            @db.Decimal(12, 2)
  discount          Decimal            @default(0) @db.Decimal(12, 2)
  shippingCharge    Decimal            @default(0) @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  couponId          String?
  customerId        String?
  paymentMethodId   String?
  paymentMethod     String?
  taxAmount         Decimal            @default(0) @db.Decimal(12, 2)
  taxType           String?
  taxIdSnapshot     String?
  taxIdTypeSnapshot String?
  taxMode           String             @default("EXCLUSIVE") // "INCLUSIVE" | "EXCLUSIVE" | "EXEMPT"
  taxLabel          String             @default("Tax")
  igstAmount        Decimal            @default(0) @db.Decimal(12, 2)
  cgstAmount        Decimal            @default(0) @db.Decimal(12, 2)
  sgstAmount        Decimal            @default(0) @db.Decimal(12, 2)
  vatAmount         Decimal            @default(0) @db.Decimal(12, 2)
  salesTaxAmount    Decimal            @default(0) @db.Decimal(12, 2)
  isZeroRated       Boolean            @default(false)
  shippingZoneId    String?
  shippingBoxId     String?
  shippingBoxName   String?
  packageWeight     Decimal?           @db.Decimal(10, 3)
  packageVolume     Decimal?           @db.Decimal(12, 2)
  couponCode        String?
  couponDiscount    Decimal?           @default(0) @db.Decimal(12, 2)
  status            OrderStatus        @default(PENDING)
  paymentStatus     PaymentStatus      @default(PENDING)
  paymentProvider   PaymentProvider?
  paymentId         String?
  shippingProvider    String?
  trackingNumber      String?
  notes               String?
  fromQuoteId         String?
  paymentExpiresAt    DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               OrderItem[]
  shipments           Shipment[]
  orderBoxes          OrderShippingBox[]
  paymentTransactions PaymentTransaction[]
  customer            Customer?            @relation(fields: [customerId], references: [id])
  country             Country              @relation(fields: [countryId], references: [id])
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  currency            Currency             @relation(fields: [currencyId], references: [id])
  quote               Quote?
  shippingZone        ShippingZone?        @relation(fields: [shippingZoneId], references: [id])
  shippingBox         ShippingBox?         @relation(fields: [shippingBoxId], references: [id])
  paymentMethodRef    PaymentMethod?       @relation(fields: [paymentMethodId], references: [id])
  warehouseId         String?
  warehouse           Warehouse?           @relation(fields: [warehouseId], references: [id])

  @@map("orders")
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  title       String
  sku         String?
  quantity    Int
  unitPrice   Decimal         @db.Decimal(12, 2)
  total       Decimal         @db.Decimal(12, 2)
  hsnCode     String?
  taxAmount   Decimal         @default(0) @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())
  order       Order           @relation(fields: [orderId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouseId String?
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])

  @@map("order_items")
}

model ShippingProvider {
  id          String         @id @default(cuid())
  name        String         @unique
  displayName String
  apiKey      String?
  apiSecret   String?
  baseUrl     String?
  trackingUrl String?
  isEnabled   Boolean        @default(false)
  config      Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  zones       ShippingZone[]
  shipments   Shipment[]

  @@map("shipping_providers")
}

model ShippingZone {
  id            String                @id @default(cuid())
  providerId    String
  charge        Decimal               @db.Decimal(10, 2)
  freeAbove     Decimal?              @db.Decimal(10, 2)
  estimatedDays String?
  status        Status                @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  orders        Order[]
  provider      ShippingProvider      @relation(fields: [providerId], references: [id])

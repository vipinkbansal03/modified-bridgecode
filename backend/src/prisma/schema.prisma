  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  countries        PaymentMethodCountry[]
  configs          PaymentMethodConfig[]
  orders           Order[]
  productOverrides ProductPaymentMethod[]
  variantOverrides VariantPaymentMethod[]

  @@map("payment_methods")
}

model PaymentMethodCountry {
  id              String        @id @default(cuid())
  paymentMethodId String
  countryId       String
  isEnabled       Boolean       @default(true)
  isDefault       Boolean       @default(false)
  minOrderAmount  Decimal?      @db.Decimal(12, 2)
  maxOrderAmount  Decimal?      @db.Decimal(12, 2)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  country         Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([paymentMethodId, countryId])
  @@map("payment_method_countries")
}

model PaymentMethodConfig {
  id              String        @id @default(cuid())
  paymentMethodId String
  environment     String        @default("PRODUCTION")
  configKey       String
  configValue     String
  isPublic        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([paymentMethodId, environment, configKey])
  @@map("payment_method_configs")
}

model Wishlist {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@map("wishlists")
}

enum AddressValidationStatus {
  VALIDATED
  UNVALIDATED
  CORRECTED
  INVALID
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("ACTIVE") // ACTIVE, UNSUBSCRIBED
  source         String    @default("FOOTER") // FOOTER, ADMIN
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("newsletter_subscribers")
}

enum PaymentMethodOverrideState {
  ALLOW
  BLOCK
}

model ProductPaymentMethod {
  id              String                     @id @default(cuid())
  productId       String
  paymentMethodId String
  state           PaymentMethodOverrideState
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([productId, paymentMethodId])
  @@map("product_payment_methods")
}

model VariantPaymentMethod {
  id              String                     @id @default(cuid())
  variantId       String
  paymentMethodId String
  state           PaymentMethodOverrideState
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([variantId, paymentMethodId])
  @@map("variant_payment_methods")
}

enum NotificationType {
  INFO
  ALERT
  ORDER
  PROMOTION
}

enum NotificationTarget {
  ALL_ADMINS
  ALL_CUSTOMERS
  SPECIFIC_USER
  SPECIFIC_CUSTOMER
}

model Notification {
  id           String             @id @default(cuid())
  title        String
  message      String             @db.Text
  type         NotificationType   @default(INFO)
  targetType   NotificationTarget @default(SPECIFIC_CUSTOMER)
  link         String?
  isRead       Boolean            @default(false)
  userId       String?
  customerId   String?
  createdAt    DateTime           @default(now())

  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
  @@index([targetType])
  @@map("notifications")
}

model DeviceToken {
  id         String    @id @default(cuid())
  token      String    @unique
  deviceType String    @default("web")
  userId     String?
  customerId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
  @@map("device_tokens")
}

model NotificationConfig {
  id              String   @id @default(cuid())
  type            String   @unique
  name            String
  isEnabled       Boolean  @default(true)
  targetRoles     String[]
  channels        Json
  rolePermissions Json?
  filters         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("notification_configs")
}

model NotificationTemplate {
  id               String   @id @default(cuid())
  type             String
  channel          String
  subject          String?  @default("")
  message          String   @db.Text
  variables        String[]
  whatsappTemplate Json?
  role             String   @default("GLOBAL")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([type, channel, role])
  @@map("notification_templates")
}

model NotificationLog {
  id                  String    @id @default(cuid())
  type                String
  channel             String
  to                  String
  subject             String?   @default("")
  message             String    @db.Text
  status              String    @default("QUEUED")
  provider            String?   @default("")
  providerReferenceId String?   @default("")
  jobId               String?   @default("")
  errorMessage        String?   @db.Text
  metadata            Json?
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("notification_logs")
}

model NotificationManagerSettings {
  id                  String   @id @default(cuid())
  key                 String   @unique @default("GLOBAL")
  masterEnabled       Boolean  @default(true)
  channelAvailability Json
  rolePermissions     Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("notification_manager_settings")
}

model WhatsAppTemplate {
  id                    String    @id @default(cuid())
  name                  String
  language              String
  category              String
  subCategory           String?   @default("")
  messageSendTtlSeconds Int?
  status                String    @default("PENDING")
  payload               Json?
  builderState          Json?
  providerResponse      Json?
  providerTemplateId    String?   @default("")
  syncPayload           Json?
  syncMessage           String    @default("")
  lastSubmittedAt       DateTime?
  lastSyncedAt          DateTime?
  lastTestSentAt        DateTime?
  archivedAt            DateTime?
  archivedBy            String?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([name, language])
  @@map("whatsapp_templates")
}

model EmailLayout {
  id          String   @id @default(cuid())
  name        String   @unique
  headerHtml  String   @db.Text
  footerHtml  String   @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_layouts")
}



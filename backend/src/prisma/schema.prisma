// This is your Prisma schema file
// Modern Orthodontics B2B Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USERS ───────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  refreshToken String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  ActivityLog       ActivityLog[]
  QuoteNote         QuoteNote[]
  customerProfile   CustomerProfile?
  customerAddresses CustomerAddress[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model CustomerProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                 String
  companyName           String?
  website               String?
  preferredPrescription PreferredPrescription?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("customer_profiles")
}

model CustomerAddress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryId     String
  country       Country  @relation(fields: [countryId], references: [id])
  label         String   @default("Primary")
  recipientName String
  phone         String?
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([countryId])
  @@map("customer_addresses")
}

enum PreferredPrescription {
  MBT
  ROTH
  OTHER
}

// ─── CATEGORIES ─────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  image       String?
  status      Status     @default(ACTIVE)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  products     Product[]
  translations CategoryTranslation[]

  @@map("categories")
}

// ─── PRODUCTS ────────────────────────────────────────────────────────────────

model Product {
  id                String        @id @default(cuid())
  title             String
  slug              String        @unique
  shortDescription  String?
  description       String?
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id])
  sku               String?       @unique
  productCode       String?
  brand             String        @default("Modern Orthodontics")
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  hasVariants       Boolean       @default(false)
  defaultCountryId  String?
  defaultCountry    Country?      @relation(fields: [defaultCountryId], references: [id])
  defaultCurrencyId String?
  defaultCurrency   Currency?     @relation(fields: [defaultCurrencyId], references: [id])
  seoTitle          String?
  seoDescription    String?
  seoKeywords       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  media        ProductMedia[]
  packages     ProductPackage[]
  attributes   ProductAttribute[]
  variants     ProductVariant[]
  prices       ProductPrice[]
  translations ProductTranslation[]
  QuoteItem    QuoteItem[]
  OrderItem    OrderItem[]

  @@map("products")
}

model ProductPackage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  title       String
  slug        String
  image       String?
  description String?
  status      Status   @default(ACTIVE)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]

  @@unique([productId, slug])
  @@map("product_packages")
}

model ProductMedia {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  url             String
  publicId        String? // Cloudinary public ID or local filename
  type            MediaType       @default(IMAGE)
  altText         String?
  sortOrder       Int             @default(0)
  storageProvider StorageProvider @default(LOCAL)
  createdAt       DateTime        @default(now())

  @@map("product_media")
}

// ─── ATTRIBUTES ──────────────────────────────────────────────────────────────

model Attribute {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    Status   @default(ACTIVE)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values            AttributeValue[]
  productAttributes ProductAttribute[]
  variantValues     ProductVariantAttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id              String    @id @default(cuid())
  attributeId     String
  attribute       Attribute @relation(fields: [attributeId], references: [id])
  value           String
  slug            String
  image           String?
  note            String?
  priceAdjustment Decimal   @default(0) @db.Decimal(12, 2)
  sortOrder       Int       @default(0)
  status          Status    @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  variantValues     ProductVariantAttributeValue[]
  productSelections ProductAttributeValueSelection[]

  @@unique([attributeId, slug])
  @@map("attribute_values")
}

model ProductAttribute {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  required    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  allowedValues ProductAttributeValueSelection[]

  @@unique([productId, attributeId])
  @@map("product_attributes")
}

model ProductAttributeValueSelection {
  id                 String           @id @default(cuid())
  productAttributeId String
  productAttribute   ProductAttribute @relation(fields: [productAttributeId], references: [id])
  attributeValueId   String
  attributeValue     AttributeValue   @relation(fields: [attributeValueId], references: [id])
  createdAt          DateTime         @default(now())

  @@unique([productAttributeId, attributeValueId])
  @@map("product_attribute_value_selections")
}

// ─── VARIANTS ────────────────────────────────────────────────────────────────

model ProductVariant {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  packageId  String?
  package    ProductPackage? @relation(fields: [packageId], references: [id])
  sku        String?         @unique
  title      String
  variantKey String // e.g. "MBT-.022-Full-Case" (combination key)
  moq        Int             @default(1)
  weight     Decimal?        @db.Decimal(10, 3)
  length     Decimal?        @db.Decimal(10, 2)
  width      Decimal?        @db.Decimal(10, 2)
  height     Decimal?        @db.Decimal(10, 2)
  status     Status          @default(ACTIVE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  attributeValues ProductVariantAttributeValue[]
  prices          ProductPrice[]
  inventory       Inventory?
  QuoteItem       QuoteItem[]
  OrderItem       OrderItem[]

  @@map("product_variants")
}

model ProductVariantAttributeValue {
  id               String         @id @default(cuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  attributeId      String
  attribute        Attribute      @relation(fields: [attributeId], references: [id])
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([variantId, attributeId])
  @@map("product_variant_attribute_values")
}

// ─── COUNTRIES & CURRENCIES ──────────────────────────────────────────────────

model Country {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique // ISO 2-letter
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])
  status     Status   @default(ACTIVE)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  prices            ProductPrice[]
  defaultProducts   Product[]
  ShippingZone      ShippingZone[]
  Quote             Quote[]
  Order             Order[]
  Coupon            Coupon[]
  customerAddresses CustomerAddress[]

  @@map("countries")
}

model Currency {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique // ISO 3-letter
  symbol       String
  exchangeRate Decimal  @db.Decimal(12, 6) // Rate vs base currency (e.g. 1 USD = 83.5 INR)
  isBase       Boolean  @default(false) // Exactly one should be true (e.g. USD)
  status       Status   @default(ACTIVE)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  countries               Country[]
  prices                  ProductPrice[]
  defaultCurrencyProducts Product[]
  Quote                   Quote[]
  Order                   Order[]
  Coupon                  Coupon[]

  @@map("currencies")
}

// ─── PRICING ─────────────────────────────────────────────────────────────────

model ProductPrice {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  countryId        String
  country          Country         @relation(fields: [countryId], references: [id])
  currencyId       String
  currency         Currency        @relation(fields: [currencyId], references: [id])
  mrp              Decimal         @db.Decimal(12, 2)
  sellingPrice     Decimal         @db.Decimal(12, 2)
  dealerPrice      Decimal?        @db.Decimal(12, 2)
  distributorPrice Decimal?        @db.Decimal(12, 2)
  taxPercentage    Decimal         @default(0) @db.Decimal(5, 2)
  status           Status          @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([productId, variantId, countryId])
  @@map("product_prices")
}

// ─── INVENTORY ───────────────────────────────────────────────────────────────

model Inventory {
  id                String          @id @default(cuid())
  productId         String
  variantId         String?         @unique
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  stock             Int             @default(0)
  reservedStock     Int             @default(0)
  lowStockThreshold Int             @default(10)
  status            InventoryStatus @default(IN_STOCK)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("inventory")
}

// ─── COUPONS ─────────────────────────────────────────────────────────────────

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usedCount     Int          @default(0)
  countryId     String?
  country       Country?     @relation(fields: [countryId], references: [id])
  currencyId    String?
  currency      Currency?    @relation(fields: [currencyId], references: [id])
  status        Status       @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders Order[]

  @@map("coupons")
}

// ─── QUOTES ──────────────────────────────────────────────────────────────────

model Quote {
  id               String      @id @default(cuid())
  quoteNumber      String      @unique
  customerName     String
  customerEmail    String
  customerPhone    String?
  companyName      String?
  countryId        String
  country          Country     @relation(fields: [countryId], references: [id])
  currencyId       String
  currency         Currency    @relation(fields: [currencyId], references: [id])
  subtotal         Decimal     @db.Decimal(12, 2)
  discount         Decimal     @default(0) @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  status           QuoteStatus @default(PENDING)
  notes            String?
  expiresAt        DateTime?
  convertedOrderId String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items         QuoteItem[]
  internalNotes QuoteNote[]
  order         Order?      @relation(fields: [convertedOrderId], references: [id])

  @@map("quotes")
}

model QuoteItem {
  id        String          @id @default(cuid())
  quoteId   String
  quote     Quote           @relation(fields: [quoteId], references: [id])
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  title     String
  sku       String?
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  total     Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now())

  @@map("quote_items")
}

model QuoteNote {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  note      String
  createdAt DateTime @default(now())

  @@map("quote_notes")
}

// ─── ORDERS ──────────────────────────────────────────────────────────────────

model Order {
  id               String           @id @default(cuid())
  orderNumber      String           @unique
  customerName     String
  customerEmail    String
  customerPhone    String?
  companyName      String?
  shippingAddress  Json
  countryId        String
  country          Country          @relation(fields: [countryId], references: [id])
  currencyId       String
  currency         Currency         @relation(fields: [currencyId], references: [id])
  subtotal         Decimal          @db.Decimal(12, 2)
  discount         Decimal          @default(0) @db.Decimal(12, 2)
  shippingCharge   Decimal          @default(0) @db.Decimal(12, 2)
  total            Decimal          @db.Decimal(12, 2)
  couponId         String?
  coupon           Coupon?          @relation(fields: [couponId], references: [id])
  status           OrderStatus      @default(PENDING)
  paymentStatus    PaymentStatus    @default(PENDING)
  paymentProvider  PaymentProvider?
  paymentId        String? // Razorpay/Stripe payment ID
  shippingProvider String? // e.g. "DHL" | "DTDC"
  trackingNumber   String?
  notes            String?
  fromQuoteId      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items OrderItem[]
  quote Quote?

  @@map("orders")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id])
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  title     String
  sku       String?
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  total     Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now())

  @@map("order_items")
}

// ─── SHIPPING ────────────────────────────────────────────────────────────────

model ShippingProvider {
  id          String   @id @default(cuid())
  name        String   @unique // "DHL" | "DTDC"
  displayName String
  apiKey      String?
  apiSecret   String?
  baseUrl     String?
  trackingUrl String? // e.g. https://www.dhl.com/en/express/tracking.html?AWB={tracking}
  isEnabled   Boolean  @default(false)
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zones ShippingZone[]

  @@map("shipping_providers")
}

model ShippingZone {
  id            String           @id @default(cuid())
  providerId    String
  provider      ShippingProvider @relation(fields: [providerId], references: [id])
  countryId     String
  country       Country          @relation(fields: [countryId], references: [id])
  charge        Decimal          @db.Decimal(10, 2)
  freeAbove     Decimal?         @db.Decimal(10, 2)
  estimatedDays String?
  status        Status           @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([providerId, countryId])
  @@map("shipping_zones")
}

// ─── PAYMENTS ────────────────────────────────────────────────────────────────

model PaymentGateway {
  id            String          @id @default(cuid())
  provider      PaymentProvider @unique
  displayName   String
  keyId         String? // Razorpay Key ID / Stripe publishable key
  keySecret     String? // Razorpay Key Secret / Stripe secret key (store encrypted)
  webhookSecret String?
  isEnabled     Boolean         @default(false)
  countries     Json            @default("[]") // country codes this gateway applies to
  config        Json            @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("payment_gateways")
}

// ─── MEDIA ───────────────────────────────────────────────────────────────────

model Media {
  id              String          @id @default(cuid())
  filename        String
  originalName    String
  url             String
  publicId        String? // Cloudinary public ID
  mimeType        String
  size            Int // bytes
  type            MediaType       @default(IMAGE)
  storageProvider StorageProvider @default(LOCAL)
  folder          String?
  createdAt       DateTime        @default(now())

  @@map("media")
}

// ─── TRANSLATIONS ────────────────────────────────────────────────────────────

model Language {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // ISO 639-1 e.g. "en", "ar", "de"
  isDefault Boolean  @default(false)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productTranslations  ProductTranslation[]
  categoryTranslations CategoryTranslation[]
  keywords             TranslationKeyword[]

  @@map("languages")
}

model ProductTranslation {
  id               String    @id @default(cuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  languageId       String
  language         Language  @relation(fields: [languageId], references: [id])
  title            String?
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?
  isAiGenerated    Boolean   @default(false)
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([productId, languageId])
  @@map("product_translations")
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  languageId  String
  language    Language @relation(fields: [languageId], references: [id])
  name        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, languageId])
  @@map("category_translations")
}

model TranslationKeyword {
  id         String   @id @default(cuid())
  key        String
  languageId String
  language   Language @relation(fields: [languageId], references: [id])
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([key, languageId])
  @@map("translation_keywords")
}

// ─── SETTINGS ────────────────────────────────────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  group     String   @default("general")
  label     String? // human-readable label shown in admin
  type      String   @default("string") // string | boolean | number | json | secret
  isSecret  Boolean  @default(false) // if true, value is AES-encrypted at rest
  isEnabled Boolean  @default(true) // used for enable/disable toggles
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

// ─── ACTIVITY LOGS ───────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "PRODUCT_CREATED", "ORDER_STATUS_UPDATED"
  entityType String? // e.g. "Product", "Order"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("activity_logs")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Status {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  BACKORDER
}

enum QuoteStatus {
  PENDING
  REVIEWING
  SENT
  ACCEPTED
  DECLINED
  CONVERTED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum MediaType {
  IMAGE
  PDF
  VIDEO
  DOCUMENT
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
}

// ─── CMS ─────────────────────────────────────────────────────────────────────

model CMSPage {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  pageKey        String       @unique
  status         String       @default("ACTIVE") // ACTIVE | INACTIVE | DRAFT
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  sections       CMSSection[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("cms_pages")
}

model CMSSection {
  id           String     @id @default(cuid())
  pageId       String
  page         CMSPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionKey   String
  title        String?
  subtitle     String?
  description  String?
  layoutType   String?
  sortOrder    Int        @default(0)
  status       String     @default("ACTIVE")
  settingsJson Json?
  blocks       CMSBlock[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("cms_sections")
}

model CMSBlock {
  id          String     @id @default(cuid())
  sectionId   String
  section     CMSSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  blockType   String
  title       String?
  subtitle    String?
  description String?
  image       String?
  icon        String?
  linkLabel   String?
  linkUrl     String?
  sortOrder   Int        @default(0)
  status      String     @default("ACTIVE")
  dataJson    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("cms_blocks")
}

model CMSMedia {
  id              String   @id @default(cuid())
  title           String?
  url             String
  type            String   @default("IMAGE") // IMAGE | VIDEO | PDF | CATALOGUE | CERTIFICATE
  altText         String?
  storageProvider String?
  size            Int?
  mimeType        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cms_media")
}

model CMSMenu {
  id        String        @id @default(cuid())
  name      String
  location  String        @unique // header | footer | mobile
  status    String        @default("ACTIVE")
  items     CMSMenuItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("cms_menus")
}

model CMSMenuItem {
  id           String   @id @default(cuid())
  menuId       String
  menu         CMSMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId     String?
  label        String
  url          String
  sortOrder    Int      @default(0)
  openInNewTab Boolean  @default(false)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("cms_menu_items")
}

model CMSFooter {
  id                String   @id @default(cuid())
  title             String?
  description       String?
  logo              String?
  address           String?
  email             String?
  phone             String?
  socialLinksJson   Json?
  newsletterEnabled Boolean  @default(true)
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("cms_footer")
}

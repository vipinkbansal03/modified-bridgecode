# ─── SERVER ──────────────────────────────────────────────
NODE_ENV=development
PORT=7001
API_PREFIX=/api

# ─── DATABASE ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/modortho"

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── FRONTEND ────────────────────────────────────────────
FRONTEND_URL=http://localhost:7000

# ─── STORAGE ─────────────────────────────────────────────
# Options: "local" | "cloudinary"
STORAGE_PROVIDER=local
LOCAL_UPLOAD_PATH=uploads

# Cloudinary (only needed when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=modortho

# ─── PAYMENTS ────────────────────────────────────────────
# Razorpay (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Global)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cashfree (India) — API version 2025-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox            # "sandbox" | "production"
CASHFREE_WEBHOOK_SECRET=
CASHFREE_WEBHOOK_BASE_URL=      # optional, default http://localhost:7001
CASHFREE_NOTIFY_URL=            # optional, default {CASHFREE_WEBHOOK_BASE_URL|localhost}/api/webhooks/cashfree
CASHFREE_RETURN_URL=            # optional, default {FRONTEND_URL}/orders/{ORDER_ID}?payment=cashfree&order_id={order_id}

# ─── SHIPPING ────────────────────────────────────────────
DHL_API_KEY=
DHL_BASE_URL=https://api-eu.dhl.com
DTDC_API_KEY=
DTDC_BASE_URL=

# ─── EMAIL SETTINGS ──────────────────────────────────────
# Options: "msg91" (default) | "nodemailer" | "resend"
EMAIL_PROVIDER=msg91
EMAIL_FROM=orders@modortho.com
EMAIL_FROM_NAME="Modern Orthodontics"
EMAIL_NOTIFY=team@modortho.com

# MSG91 Unified Configuration (Email, SMS/OTP, WhatsApp)
MSG91_AUTH_KEY=
MSG91_DOMAIN=                     # optional verified domain in MSG91 (e.g. modortho.com)
MSG91_FROM_EMAIL=orders@modortho.com
MSG91_FROM_NAME="Modern Orthodontics"
MSG91_SMS_SENDER_ID=              # 6-character DLT approved Sender ID (e.g. MODORT)
MSG91_OTP_TEMPLATE_ID=            # MSG91 OTP Template ID
MSG91_WHATSAPP_NUMBER=            # Verified WhatsApp integrated number (e.g. 919240213800)
MSG91_FLOW_ID=                    # Optional MSG91 Campaign/Flow ID for SMS alerts

# Nodemailer / SMTP Configuration (only used when EMAIL_PROVIDER=nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false                 # true for 465, false for 587
SMTP_USER=
SMTP_PASS=

# Resend Configuration (only used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ─── AI / LANGCHAIN ──────────────────────────────────────
OPENAI_API_KEY=
AI_PROVIDER=openai

# ─── CURRENCY SYNC ───────────────────────────────────────
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# ─── LOGGING ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs


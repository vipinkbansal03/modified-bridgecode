# ─── SERVER ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ─── DATABASE ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:123@localhost:5432/modortho"

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── FRONTEND ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── STORAGE ─────────────────────────────────────────────
# Options: "local" | "cloudinary"
STORAGE_PROVIDER=local
LOCAL_UPLOAD_PATH=uploads

# Cloudinary (only needed when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=modortho

# ─── PAYMENTS ────────────────────────────────────────────
# Razorpay (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Global)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cashfree (India) — API version 2025-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox            # "sandbox" | "production"
CASHFREE_WEBHOOK_SECRET=
CASHFREE_WEBHOOK_BASE_URL=      # optional, default http://localhost:4000
CASHFREE_NOTIFY_URL=            # optional, default {CASHFREE_WEBHOOK_BASE_URL|localhost}/api/webhooks/cashfree
CASHFREE_RETURN_URL=            # optional, default {FRONTEND_URL}/orders/{ORDER_ID}?payment=cashfree&order_id={order_id}

# ─── SHIPPING ────────────────────────────────────────────
DHL_API_KEY=
DHL_BASE_URL=https://api-eu.dhl.com
DTDC_API_KEY=
DTDC_BASE_URL=

# ─── EMAIL (Resend) ──────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=orders@modortho.com
EMAIL_NOTIFY=team@modortho.com

# ─── AI / LANGCHAIN ──────────────────────────────────────
OPENAI_API_KEY=
AI_PROVIDER=openai

# ─── CURRENCY SYNC ───────────────────────────────────────
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# ─── LOGGING ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs


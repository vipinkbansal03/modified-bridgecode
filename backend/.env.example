# ─── SERVER ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ─── DATABASE ────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/modortho?schema=public"

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── FRONTEND ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── STORAGE ─────────────────────────────────────────────
# Options: "local" | "cloudinary"
STORAGE_PROVIDER=local
LOCAL_UPLOAD_PATH=uploads

# Cloudinary (only needed when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=modortho

# ─── PAYMENTS ────────────────────────────────────────────
# Razorpay (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Global)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── SHIPPING ────────────────────────────────────────────
DHL_API_KEY=
DHL_BASE_URL=https://api-eu.dhl.com
DTDC_API_KEY=
DTDC_BASE_URL=

# ─── AI / LANGCHAIN ──────────────────────────────────────
OPENAI_API_KEY=
AI_PROVIDER=openai

# ─── LOGGING ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

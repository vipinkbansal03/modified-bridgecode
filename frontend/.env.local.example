# ─── Backend connection ──────────────────────────────────────────────────────
# Next.js proxies /api/* to BACKEND_URL. This is the recommended local setup.
BACKEND_URL=http://localhost:4000

# Optional: call the backend directly from the browser instead of via Next.js.
# Useful in production when the frontend and backend are deployed separately.
# NEXT_PUBLIC_API_URL=https://api.modortho.com

# Optional: force the storefront to use bundled JSON instead of the backend.
# NEXT_PUBLIC_USE_STATIC_DATA=true

# ─── Optional: enable React Query Devtools in development ────────────────────
# NEXT_PUBLIC_RQ_DEVTOOLS=true
